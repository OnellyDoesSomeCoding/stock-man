# Copy this file to .env and fill it in. .env is git-ignored; never commit it.
#
# All MT5 values are OPTIONAL. If you leave them empty, the scripts attach to
# the MT5 terminal that is already open and logged in (simplest).

# Demo account number (digits only), password and server name as shown in MT5
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Full path to terminal64.exe, only needed if you have more than one MT5 installed
# e.g. C:\Program Files\MetaTrader 5\terminal64.exe
MT5_PATH=

# Phase 3 (not used yet)
DISCORD_WEBHOOK_URL=
